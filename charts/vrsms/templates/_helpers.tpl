{{/*
Shared naming helpers. Every chart generated by "helm create" carries these;
they keep resource names consistent and under Kubernetes' 63-character limit.
*/}}

{{- define "vrsms.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{- define "vrsms.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- .Release.Name | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}

{{/* Labels on every object, so "kubectl get all -l app.kubernetes.io/instance=vrsms" works. */}}
{{- define "vrsms.labels" -}}
app.kubernetes.io/name: {{ include "vrsms.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" }}
{{- end -}}

{{/* The subset used as the Deployment selector. Must stay stable: selectors are immutable. */}}
{{- define "vrsms.selectorLabels" -}}
app.kubernetes.io/name: {{ include "vrsms.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end -}}

{{- define "vrsms.postgres.fullname" -}}
{{- printf "%s-postgres" (include "vrsms.fullname" .) | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/* JDBC URL pointing at the in-cluster PostgreSQL Service. */}}
{{- define "vrsms.jdbcUrl" -}}
{{- printf "jdbc:postgresql://%s:5432/%s" (include "vrsms.postgres.fullname" .) .Values.postgres.database -}}
{{- end -}}
